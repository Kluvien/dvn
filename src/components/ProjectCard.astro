---
interface Project {
  title: string;
  description: string;
  thumbnail: string | null;
  link: string;
  tags?: string[];
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50"
>
  <div
    class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/80"
  >
    {
      project.thumbnail ? (
        <img
          src={project.thumbnail}
          alt={project.title}
          class="h-48 w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-48 w-full items-center justify-center bg-slate-800 p-5">
          <p class="text-sm font-medium text-slate-300">No Thumbnail</p>
        </div>
      )
    }
  </div>

  <h2 class="mt-5 text-2xl font-bold text-white">
    {project.title}
  </h2>

  <p class="mt-4 flex-1 leading-7 text-slate-400">
    {project.description}
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      project.tags?.map((tag) => (
        <span class="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-sm text-slate-300">
          {tag}
        </span>
      ))
    }
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-5">
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center font-semibold text-indigo-400 transition hover:text-indigo-300"
    >
      View project
      <span class="ml-2" aria-hidden="true">→</span>
    </a>
  </div>
</article>
