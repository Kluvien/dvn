---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50"
>
  <div
    class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/80"
  >
    {
      project.image ? (
        <img
          src={project.image}
          alt={project.title}
          class="h-48 w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-48 w-full items-end justify-between gap-4 bg-linear-to-br from-slate-900 via-slate-950 to-slate-900 p-5">
          <div>
            <p class="text-sm font-semibold text-indigo-400">
              {project.category}
            </p>

            <p class="mt-2 max-w-[16rem] text-xl font-bold text-white">
              {project.title}
            </p>
          </div>

          <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/10 px-3 py-2 text-xs font-semibold text-indigo-300">
            {project.status}
          </div>
        </div>
      )
    }
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm font-semibold text-indigo-400">
      {project.category}
    </p>

    <span
      class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300"
    >
      {project.status}
    </span>
  </div>

  <h2 class="mt-5 text-2xl font-bold text-white">
    {project.title}
  </h2>

  <p class="mt-4 flex-1 leading-7 text-slate-400">
    {project.description}
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      project.technologies.map((technology) => (
        <span class="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-sm text-slate-300">
          {technology}
        </span>
      ))
    }
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-5">
    <a
      href={`/projects/${project.slug}`}
      class="inline-flex items-center font-semibold text-indigo-400 transition hover:text-indigo-300"
    >
      View project
      <span class="ml-2" aria-hidden="true">→</span>
    </a>

    {
      project.repository && (
        <a
          href={project.repository}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-slate-400 transition hover:text-white"
        >
          Repository
        </a>
      )
    }
  </div>
</article>
