---
import type { Member } from "../data/members";

interface Props {
  member: Member;
}

const { member } = Astro.props;
---

<article
  class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50"
>
  <div
    class="flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-500 text-xl font-bold text-white"
    aria-hidden="true"
  >
    {member.displayName.slice(0, 2).toUpperCase()}
  </div>

  <p class="mt-6 text-sm font-semibold text-indigo-400">
    {member.role}
  </p>

  <h2 class="mt-2 text-2xl font-bold text-white">
    {member.displayName}
  </h2>

  <p class="mt-4 leading-7 text-slate-400">
    {member.description}
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      member.skills.map((skill) => (
        <span
          class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-sm text-slate-300"
        >
          {skill}
        </span>
      ))
    }
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-5">
    <a
      href={`/members/${member.slug}`}
      class="inline-flex items-center font-semibold text-indigo-400 transition hover:text-indigo-300"
    >
      View profile
      <span class="ml-2" aria-hidden="true">→</span>
    </a>

    {
      member.github && (
        <a
          href={member.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-slate-400 transition hover:text-white"
        >
          GitHub
        </a>
      )
    }
  </div>
</article>