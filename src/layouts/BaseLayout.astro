---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Altiora",
  description = "Altiora adalah kolektif kreatif dan teknologi.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title === "Altiora" ? title : `${title} | Altiora`;
const ogImageUrl = new URL("/og-image.svg", Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link rel="canonical" href={canonicalUrl} />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#020617" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Altiora" />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <title>{pageTitle}</title>
  </head>

  <body
    class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased"
  >
    <Navbar />

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
  </body>
</html>