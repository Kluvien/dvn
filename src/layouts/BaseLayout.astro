---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Altiora",
  description = "Altiora adalah kolektif kreatif dan teknologi.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body
    class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased"
  >
    <Navbar />

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
  </body>
</html>