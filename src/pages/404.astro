---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Altiora"
  description="Halaman yang kamu cari tidak ditemukan di Altiora."
>
  <main
    class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-7xl items-center px-6 py-20 sm:py-28"
  >
    <section class="max-w-2xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.3em] text-indigo-400"
      >
        404
      </p>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-6xl">
        This page doesn’t exist.
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-400">
        Halaman yang kamu tuju tidak tersedia. Kembali ke beranda untuk melihat
        proyek, anggota, dan layanan Altiora.
      </p>

      <a
        href="/"
        class="mt-8 inline-flex rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
      >
        Back to Altiora
      </a>
    </section>
  </main>
</BaseLayout>
