---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About — Altiora"
  description="Mengenal Altiora, identitas kolektif yang menaungi proyek kreatif dan teknologi."
>
  <main
    class="mx-auto min-h-[calc(100vh-4rem)] max-w-7xl px-6 py-20 sm:py-28"
  >
    <section class="max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.3em] text-indigo-400"
      >
        About Altiora
      </p>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Tempat ide, karya, dan kolaborasi bertumbuh.
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-400">
        Altiora adalah identitas kolektif kreatif dan teknologi yang menaungi
        proyek, portofolio, serta karya Devan dan saudara-saudaranya.
      </p>

      <p class="mt-4 text-lg leading-8 text-slate-400">
        Melalui Altiora, setiap anggota dapat memperkenalkan kemampuan,
        mendokumentasikan proses berkarya, dan membangun proyek bersama dalam
        satu identitas yang konsisten.
      </p>
    </section>
  </main>
</BaseLayout>