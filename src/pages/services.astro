---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "Web Development",
    description:
      "Pengembangan website profil, landing page, dan aplikasi web ringan dengan struktur yang rapi dan mudah dipelihara.",
    tags: ["Astro", "Laravel", "TypeScript"],
    icon: "web",
  },
  {
    number: "02",
    title: "Game Development",
    description:
      "Eksplorasi game berbasis Unity, termasuk prototype gameplay, interaksi pemain, dan mekanik inti.",
    tags: ["Unity", "C#", "Game Design"],
    icon: "game",
  },
  {
    number: "03",
    title: "Digital Art",
    description:
      "Karya drawing digital dengan fokus pada karakter dan eksplorasi visual yang konsisten.",
    tags: ["Drawing"],
    icon: "art",
  },
] as const;
---

<BaseLayout
  title="Services — Altiora"
  description="Layanan dan kemampuan yang tersedia melalui Altiora."
>
  <main class="mx-auto max-w-7xl px-6 py-20 sm:py-28">
    <section class="max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.3em] text-indigo-400"
      >
        Services
      </p>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-6xl">
        What we can build and create.
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-400">
        Altiora menggabungkan kemampuan di bidang teknologi dan kreativitas
        untuk mengembangkan berbagai jenis proyek digital.
      </p>
    </section>

    <section class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="flex h-full flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-500 text-white">
              {service.icon === "web" && (
                <svg
                  width="30"
                  height="30"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 9 4 12l4 3" />
                  <path d="M16 9l4 3-4 3" />
                  <path d="M14 5 10 19" />
                </svg>
              )}

              {service.icon === "game" && (
                <svg
                  width="30"
                  height="30"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 7h10a4 4 0 0 1 4 4v1a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-1a4 4 0 0 1 4-4Z" />
                  <path d="M8 12h4" />
                  <path d="M10 10v4" />
                  <path d="M15 11h.01" />
                  <path d="M18 13h.01" />
                </svg>
              )}

              {service.icon === "art" && (
                <svg
                  width="30"
                  height="30"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14.5 4.5 19.5 9.5" />
                  <path d="M13 6 4 15l-1 5 5-1 9-9" />
                  <path d="M4 15c2 0 3 1 3 3" />
                </svg>
              )}
            </div>

            <p class="mt-6 text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">
              {service.number}
            </p>

            <h2 class="mt-2 text-2xl font-bold text-white">{service.title}</h2>

            <p class="mt-4 flex-1 leading-7 text-slate-400">
              {service.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {service.tags.map((tag) => (
                <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-sm text-slate-300">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </section>

    <section class="mt-8">
      <div
        class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 px-6 py-10 sm:px-10 sm:py-12"
      >
        <div
          class="pointer-events-none absolute right-0 top-0 hidden h-full w-[46%] lg:block"
          aria-hidden="true"
        >
          <svg class="h-full w-full" viewBox="0 0 520 320" fill="none">
            <ellipse
              cx="300"
              cy="160"
              rx="170"
              ry="78"
              transform="rotate(10 300 160)"
              stroke="#4f46e5"
              stroke-opacity="0.45"></ellipse>
            <ellipse
              cx="305"
              cy="160"
              rx="128"
              ry="54"
              transform="rotate(10 305 160)"
              stroke="#6366f1"
              stroke-opacity="0.35"></ellipse>
            <ellipse
              cx="310"
              cy="160"
              rx="86"
              ry="34"
              transform="rotate(10 310 160)"
              stroke="#818cf8"
              stroke-opacity="0.25"></ellipse>
            <circle cx="150" cy="118" r="4" fill="#818cf8"></circle>
            <circle cx="395" cy="204" r="4" fill="#6366f1"></circle>
            <circle cx="452" cy="144" r="3.5" fill="#a5b4fc"></circle>
            <circle cx="226" cy="90" r="3" fill="#c7d2fe"></circle>
          </svg>
        </div>

        <div class="relative z-10 max-w-2xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.3em] text-indigo-400"
          >
            Collaboration
          </p>

          <h2
            class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
          >
            Have an idea you want to discuss?
          </h2>

          <p class="mt-5 max-w-xl leading-7 text-slate-400">
            Detail layanan dan proses kerja masih terus dikembangkan. Untuk saat
            ini, diskusi proyek dapat dimulai melalui halaman kontak.
          </p>

          <a
            href="/contact"
            class="mt-8 inline-flex items-center rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
          >
            Contact Altiora
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
