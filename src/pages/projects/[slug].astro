---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} — Altiora`}
  description={project.description}
>
  <main
    class="mx-auto min-h-[calc(100vh-4rem)] max-w-7xl px-6 py-16 sm:py-24"
  >
    <a
      href="/projects"
      class="inline-flex items-center text-sm font-semibold text-slate-400 transition hover:text-white"
    >
      <span class="mr-2" aria-hidden="true">←</span>
      Back to projects
    </a>

    <section class="mt-12 max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <p
          class="text-sm font-semibold uppercase tracking-[0.25em] text-indigo-400"
        >
          {project.category}
        </p>

        <span
          class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs font-medium text-slate-300"
        >
          {project.status}
        </span>
      </div>

      <h1
        class="mt-5 text-4xl font-bold tracking-tight text-white sm:text-6xl"
      >
        {project.title}
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-300">
        {project.description}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          project.technologies.map((technology) => (
            <span
              class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-300"
            >
              {technology}
            </span>
          ))
        }
      </div>

      <section class="mt-16">
        <h2 class="text-2xl font-bold text-white">
          Project highlights
        </h2>

        <ul class="mt-6 space-y-4">
          {
            project.highlights.map((highlight) => (
              <li class="flex gap-3 leading-7 text-slate-400">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-indigo-500" />
                <span>{highlight}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        project.repository && (
          <a
            href={project.repository}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-12 inline-flex rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
          >
            Open repository
            <span class="ml-2" aria-hidden="true">↗</span>
          </a>
        )
      }
    </section>
  </main>
</BaseLayout>