---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { members, type Member } from "../../data/members";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return members.map((member) => ({
    params: {
      slug: member.slug,
    },
    props: {
      member,
    },
  }));
}

interface Props {
  member: Member;
}

const { member } = Astro.props;

const initials =
  member.displayName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("") || member.displayName.slice(0, 2).toUpperCase();

const relatedProjects = projects.filter(
  (project) => project.memberSlug === member.slug,
);

const socialLinks =
  member.socialLinks ??
  (member.github
    ? [
        {
          label: "GitHub",
          href: member.github,
        },
      ]
    : []);
---

<BaseLayout
  title={`${member.displayName} — Altiora`}
  description={`Profil ${member.displayName}, ${member.role} di Altiora.`}
>
  <main class="mx-auto min-h-[calc(100vh-4rem)] max-w-7xl px-6 py-16 sm:py-24">
    <a
      href="/members"
      class="inline-flex items-center text-sm font-semibold text-slate-400 transition hover:text-white"
    >
      <span class="mr-2" aria-hidden="true">←</span>
      Back to members
    </a>

    <section class="mt-12 grid items-start gap-12 lg:grid-cols-[280px_1fr]">
      <div
        class="overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/60 aspect-square shadow-2xl shadow-slate-950/20"
      >
        {
          member.image ? (
            <img
              src={member.image}
              alt={member.displayName}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-indigo-500 text-6xl font-bold text-white">
              {initials}
            </div>
          )
        }
      </div>

      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.3em] text-indigo-400"
        >
          {member.role}
        </p>

        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-6xl"
        >
          {member.displayName}
        </h1>

        <p class="mt-8 text-lg leading-8 text-slate-300">
          {member.description}
        </p>

        <div class="mt-10">
          <h2
            class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500"
          >
            Skills and tools
          </h2>

          <div class="mt-4 flex flex-wrap gap-3">
            {
              member.skills.map((skill) => (
                <span class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-300">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        {
          socialLinks.length > 0 && (
            <div class="mt-10 flex flex-wrap gap-3">
              {socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
                >
                  {link.label}
                  <span class="ml-2" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))}
            </div>
          )
        }

        {
          relatedProjects.length > 0 && (
            <section class="mt-12">
              <h2 class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">
                Portfolio
              </h2>

              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {relatedProjects.map((project) => (
                  <a
                    href={`/projects/${project.slug}`}
                    class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 transition hover:-translate-y-1 hover:border-indigo-500/50"
                  >
                    <p class="text-sm font-semibold text-indigo-400">
                      {project.category}
                    </p>
                    <h3 class="mt-2 text-lg font-bold text-white">
                      {project.title}
                    </h3>
                    <p class="mt-3 text-sm leading-6 text-slate-400">
                      {project.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
