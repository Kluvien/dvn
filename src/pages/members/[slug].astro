---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { members, type Member } from "../../data/members";

export function getStaticPaths() {
  return members.map((member) => ({
    params: {
      slug: member.slug,
    },
    props: {
      member,
    },
  }));
}

interface Props {
  member: Member;
}

const { member } = Astro.props;
---

<BaseLayout
  title={`${member.displayName} — Altiora`}
  description={`Profil ${member.displayName}, ${member.role} di Altiora.`}
>
  <main class="mx-auto min-h-[calc(100vh-4rem)] max-w-7xl px-6 py-16 sm:py-24">
    <a
      href="/members"
      class="inline-flex items-center text-sm font-semibold text-slate-400 transition hover:text-white"
    >
      <span class="mr-2" aria-hidden="true">←</span>
      Back to members
    </a>

    <section class="mt-12 grid items-start gap-12 lg:grid-cols-[280px_1fr]">
      <div
        class="flex aspect-square items-center justify-center rounded-3xl border border-indigo-500/30 bg-indigo-500 text-6xl font-bold text-white shadow-2xl shadow-indigo-950/40"
        aria-hidden="true"
      >
        {member.displayName.slice(0, 2).toUpperCase()}
      </div>

      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.3em] text-indigo-400"
        >
          {member.role}
        </p>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-6xl">
          {member.displayName}
        </h1>

        <p class="mt-8 text-lg leading-8 text-slate-300">
          {member.description}
        </p>

        <div class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">
            Skills and tools
          </h2>

          <div class="mt-4 flex flex-wrap gap-3">
            {
              member.skills.map((skill) => (
                <span
                  class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-300"
                >
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        {
          member.github && (
            <a
              href={member.github}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-10 inline-flex rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
            >
              Visit GitHub
              <span class="ml-2" aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>